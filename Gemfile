source "https://rubygems.org"

# Only needed to preview locally: bundle install && bundle exec jekyll serve
# GitHub builds the live site itself with Jekyll 3.10, so pin the same version here.
# (The official "github-pages" gem doesn't install on Ruby 4 yet.)
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm"

# Standard libraries that newer Ruby no longer includes by default.
gem "webrick"
gem "logger"
gem "base64"
gem "bigdecimal"
